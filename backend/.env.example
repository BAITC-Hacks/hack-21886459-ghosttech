# Empty = backend/data/app.sqlite3. Relative SQLite paths resolve from backend/.
DATABASE_URL=
# Example: postgresql+psycopg://user:password@localhost:5432/ghosttech
FRONTEND_ORIGINS=["http://127.0.0.1:8080","http://localhost:8080"]
# auto: OpenAI when a key is present, otherwise a visible demo mode.
# openai: require OpenAI; configuration/provider errors are never hidden by a demo fallback.
# demo: always use the local assistant, without API calls.
AI_MODE=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_TIMEOUT_SECONDS=60
